# Configuration structure for local development
# DO NOT fill in real API keys here!
# Use IaC (Infrastructure as Code) to manage secrets in production.
# See docs/INFRASTRUCTURE.md and infra/ directory for details.

DATABASE_URL=postgres://user:password@host:5432/database
ASHBY_JOB_BOARD=job-board-name
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY - Injected via IaC or secret management
# GOOGLE_API_KEY - Injected via IaC or secret management  
# OPENAI_API_KEY - Injected via IaC or secret management
