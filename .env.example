# Database Configuration
DATABASE_URL=postgres://job_hunter:job_hunter@localhost:5432/job_hunter

# Ashby Integration
ASHBY_JOB_BOARD=example

# AI Provider Configuration
# Select one: anthropic (default), google, openai
AI_PROVIDER=anthropic

# API Keys
# ⚠️  NEVER commit .env file to git repository!
# Set these environment variables from a secure configuration management system.
# Each key is used based on the selected AI_PROVIDER.
#
# For Anthropic (Claude):
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# For Google (Gemini):
# GOOGLE_API_KEY=<your-google-api-key>
# For OpenAI (GPT):
# OPENAI_API_KEY=<your-openai-api-key>

# Optional: Override default AI models
# Uncomment and modify if needed (defaults provided in factory):
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# GOOGLE_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
