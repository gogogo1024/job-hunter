{
  "name": "@job-hunter/shared",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": { "dev": "tsc -b tsconfig.build.json --watch", "build": "tsc -b tsconfig.build.json", "typecheck": "tsc --noEmit" },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@job-hunter/types": "workspace:*"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
