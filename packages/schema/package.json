{
  "name": "@job-hunter/schema",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": { "build": "tsc -b tsconfig.build.json", "dev": "tsc -b tsconfig.build.json --watch", "typecheck": "tsc --noEmit" },
  "dependencies": { "zod": "latest", "@job-hunter/shared": "workspace:*" },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts"
}
