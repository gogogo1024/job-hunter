{
  "name": "@job-hunter/db",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "tsc -b tsconfig.build.json --watch",
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@job-hunter/shared": "workspace:*",
    "drizzle-orm": "latest",
    "dotenv": "latest",
    "postgres": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "latest",
    "typescript": "latest"
  },
  "exports": { ".": "./dist/index.js" },
  "types": "./dist/index.d.ts"
}
